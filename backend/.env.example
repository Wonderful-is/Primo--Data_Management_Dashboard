# Copy this file to `.env` for local development (don't commit the real .env).

# Neon Postgres connection string.
# Get this from the Neon dashboard -> Connection Details -> "Connection string"
# It must include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Comma-separated list of allowed origins for CORS (your Vercel frontend URL).
# Use "*" for "allow everything" (fine for testing, not recommended for prod).
ALLOWED_ORIGINS=*
